---
import '../styles/global.css';
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-teal-500 selection:text-slate-950 min-h-screen">
    <slot />

    <script>
      function setupScrollAnimations() {
        const observerOptions: IntersectionObserverInit = {
          root: null,
          rootMargin: '0px 0px -80px 0px', // Attiva l'animazione poco prima che entri del tutto a schermo
          threshold: 0.15 // Richiede che almeno il 15% della sezione sia visibile
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              // Smette di osservare dopo che si è animata per evitare spreco di risorse
              obs.unobserve(entry.target);
            }
          });
        }, observerOptions);

        const elementsToAnimate = document.querySelectorAll('.reveal-on-scroll');
        elementsToAnimate.forEach((el) => observer.observe(el));
      }

      // Esegui lo script quando il DOM è pronto
      document.addEventListener('DOMContentLoaded', setupScrollAnimations);
      // Supporto per eventuali View Transitions di Astro
      document.addEventListener('astro:page-load', setupScrollAnimations);
    </script>
  </body>
</html>