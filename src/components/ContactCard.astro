---
interface Props {
  title: string;
  value: string;
  href?: string;
}

const { title, value, href } = Astro.props;
---

<div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80 hover:border-teal-500/50 transition-all group">
  <h3 class="text-xs font-semibold uppercase tracking-wider text-teal-400 mb-2">{title}</h3>
  {href ? (
    <a href={href} target="_blank" rel="noopener noreferrer" class="text-lg font-medium text-white group-hover:text-teal-300 transition-colors inline-flex items-center gap-1">
      {value}
      <span class="text-xs opacity-70 group-hover:translate-x-1 transition-transform">↗</span>
    </a>
  ) : (
    <p class="text-lg font-medium text-white">{value}</p>
  )}
</div>